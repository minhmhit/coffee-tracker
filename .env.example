# ==============================================================================
# ENVIRONMENT CONFIGURATION — COFFEE TRACKER
# ==============================================================================
NODE_ENV=development
PORT=3001
TZ=Asia/Ho_Chi_Minh

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coffee_tracker
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coffee_tracker?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- ML Service (FastAPI) ---
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# --- Frontend (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INTERNAL_API_URL=http://orchestrator:3001

# --- Telegram Bot Alerting ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_USERNAME=minhmh_coffee_tracker_bot
TELEGRAM_BRIEFING_CRON="0 6 * * *"
# Mode: 'polling' (local Docker Compose) | 'webhook' (Cloud Free Tier / Render)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=replace_with_random_telegram_webhook_secret

# --- Cloud Free-Tier & Hardening Settings (Phase 7) ---
# Queue mode: 'bullmq' (local Docker Compose) | 'direct' (Cloud Free Tier without 24/7 Redis polling)
QUEUE_MODE=bullmq
# Optional Upstash TLS Redis URL (used when QUEUE_MODE=bullmq on cloud)
REDIS_URL=
# Secret key guarding POST /api/forecast/trigger, POST /api/alerts/briefing/trigger, POST /api/ingestion/sync
ADMIN_API_KEY=replace_with_strong_admin_api_key
# Comma-separated allowed browser origins for CORS (e.g. https://coffee-tracker.vercel.app,http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
# Set 'true' on cloud environments where ML Service may sleep before weekly forecast calls
ML_WAKE_BEFORE_FORECAST=false
# Override ML HTTP timeout in ms (use 300000 when running ML on Render Free 0.1 vCPU)
ML_SERVICE_TIMEOUT_MS=180000
